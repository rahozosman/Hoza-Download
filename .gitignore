# ---------------------------------------------------------------------------
# Hoza Download — files that never belong in the repository.
# ---------------------------------------------------------------------------

# Operating system and editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.history/
.atom/
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
/android/.idea/

# Flutter / Dart / Pub
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
migrate_working_dir/
*.log

# Generated platform build output
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/.gradle/
/android/local.properties
/android/captures/
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Runner.xcworkspace/xcuserdata/
/macos/Pods/
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/
/windows/flutter/ephemeral/
/web/.dart_tool/

# Symbolication and obfuscation maps
app.*.symbols
app.*.map.json

# Release signing material — NEVER commit these. Losing control of the
# keystore means losing the ability to update the app on the store.
key.properties
/android/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
google-services.json
GoogleService-Info.plist

# Environment and secrets
.env
.env.*
!.env.example
*.secret

# Backend (server/) — Python runtime and data it writes
/server/.venv/
/server/venv/
/server/__pycache__/
/server/**/__pycache__/
/server/*.pyc
/server/events.jsonl
/server/*.db
/server/.pytest_cache/

# Scratch images and exports dropped in the project root (design references,
# screenshots from chat tools). Real assets live under assets/.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.psd
/*.ai

# Private working notes for the AI assistant — not part of the product.
/HOZA_DOWNLOAD_CLAUDE_CODE_RULES.md
/HOZA_DOWNLOAD_CLAUDE_CODE_RULES_02_ENGINEERING.md
/HOZA_DOWNLOAD_CLAUDE_CODE_RULES*.md
/CLAUDE.md
/.claude/

# Local notes and machine-specific tooling output
/tool/output/
/tmp/
*.orig
*.rej
*.bak
