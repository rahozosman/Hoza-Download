<?xml version="1.0" encoding="utf-8"?>
<!-- Same two layers as ic_launcher, so a launcher that asks for the round
     variant gets the identical mark rather than a second, older drawing. The
     inset keeps the ring clear of the circular crop. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="18%" />
  </foreground>
</adaptive-icon>
