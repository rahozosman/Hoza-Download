<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Downloading media and reading link metadata both need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keeps transfers running while the app is off screen. Android requires an
         ongoing notification for this, which is exactly what the user wants to
         see while a download is in progress. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ requires consent before any notification is shown. Refusing
         it only hides the progress notification; downloads still work. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 9 and older only: MediaStore.Downloads does not exist there, so
         finished files are written to the public Downloads folder instead.
         Android 10+ needs no storage permission at all, and
         MANAGE_EXTERNAL_STORAGE is never requested. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="Hoza Download"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Share target: "Hoza Download" appears in the Android share sheet for
             plain text, which is how links are shared.

             It is a translucent window in its own task, so picking Hoza from
             YouTube's share sheet slides the download sheet up over YouTube
             rather than switching the user into this app. singleTask means a
             second share reuses the same window through onNewIntent, and it is
             kept out of Recents because it is a sheet, not a screen. -->
        <activity
            android:name=".ShareSheetActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.hoza.download.share"
            android:excludeFromRecents="true"
            android:theme="@style/ShareSheetTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Keeps the window translucent once the engine attaches; the
                 default swap to NormalTheme would paint it opaque. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/ShareSheetTheme"
                />
            <intent-filter android:label="Hoza Download">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <!-- Runs only while at least one transfer is active, and stops itself
             as soon as the last one finishes. -->
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Buttons on the ongoing download notification. -->
        <receiver
            android:name=".DownloadActionReceiver"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Needed on Android 11+ to check whether anything can play a saved
             file before offering "Open", and to build the share sheet. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="video/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="audio/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="image/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
